---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import CoverImage from "@/components/common/CoverImage.astro";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug, getTagUrl } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	class?: string;
	style?: string;
	loading?: "lazy" | "eager";
}

const { entry, class: className, style, loading = "lazy" } = Astro.props;
const { remarkPluginFrontmatter } = await render(entry);

const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);
const hasCover = !!processedImage;

const postUrl = getPostUrlBySlug(entry.id);
const tags = (entry.data.tags || []).slice(0, 2);

const date = new Date(entry.data.published);
const dateText = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(
	2,
	"0",
)}-${String(date.getDate()).padStart(2, "0")}`;

const words = remarkPluginFrontmatter.words ?? 0;
const minutes = remarkPluginFrontmatter.minutes ?? 0;
const wordsText = words >= 1000 ? `${(words / 1000).toFixed(1)}k` : String(words);

const excerpt: string =
	entry.data.description || remarkPluginFrontmatter.excerpt || "";

// 无封面时的字体化封面标签
const typoLabel = (() => {
	const latin = entry.data.title.match(/[A-Za-z0-9]+/);
	if (latin) return latin[0].slice(0, 4).toUpperCase();
	return entry.data.title.slice(0, 2);
})();
---

<article class:list={["post-card", !hasCover && "no-cover", className]} style={style}>
	<a class="post-card-cover" href={postUrl} aria-label={entry.data.title}>
		{hasCover ? (
			<CoverImage
				src={processedImage}
				basePath={getFileDirFromPath(entry.filePath || "")}
				alt={entry.data.title}
				class="w-full h-full"
				preview={true}
				loading={loading}
				apiUrls={apiUrls}
			/>
		) : (
			<span class="typo-cover">
				<span class="typo-label">{typoLabel}</span>
			</span>
		)}
		{entry.data.category && <span class="chip">{entry.data.category}</span>}
	</a>

	<div class="post-card-body">
		<h3 class="post-card-title">
			<a href={postUrl}>{entry.data.title}</a>
		</h3>
		{excerpt && <p class="post-card-excerpt">{excerpt}</p>}
		{tags.length > 0 && (
			<div class="post-card-tags">
				{tags.map((tag) => (
					<a class="tag" href={getTagUrl(tag)}>
						#{tag.trim()}
					</a>
				))}
			</div>
		)}
		<div class="post-card-meta">
			<span class="meta-item">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 9h18M8 2v4M16 2v4" /></svg>
				{dateText}
			</span>
			<span class="spacer"></span>
			<span class="reading-badge">
				{wordsText} 字 · {minutes} min
			</span>
		</div>
	</div>
</article>

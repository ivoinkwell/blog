---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const msgPost = await getEntry("spec", "msg");

if (!msgPost) {
	throw new Error("Message board page content not found");
}

const { Content } = await render(msgPost);
---
<!-- 页面内容在 src/content/spec/msg.md 里，导航入口在 src/config.ts -->
<MainGridLayout title="留言板" description="匿名留言板">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>